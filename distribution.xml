<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="1">
    <title>EIDReader</title>
    <organization>com.example</organization>
    <domains enable_anywhere="true"/>
    <options customize="never" require-scripts="true"/>
    <choices-outline>
        <line choice="default">
            <line choice="EIDReader"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="EIDReader" visible="false">
        <pkg-ref id="com.example.EIDReader"/>
    </choice>
    <pkg-ref id="com.example.EIDReader" auth="Root">EIDReader.pkg</pkg-ref>
</installer-gui-script> 